# Copy to .env.local and fill in from Supabase: Project Settings → API Keys.
# The publishable key is safe in the browser; Row Level Security limits it to reading.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Byl payments (server-only — never prefix with NEXT_PUBLIC_).
# Byl → your project → Тохиргоо → API токэн. The token is shown once; one token per environment.
BYL_PROJECT_ID=
BYL_TOKEN=
# Order deposit in tögrög (default 100000).
BYL_DEPOSIT_AMOUNT=100000
# Byl → project → Webhooks → your endpoint → Signing secret.
BYL_WEBHOOK_SECRET=

# Supabase → Project Settings → API Keys → Secret key. Server-only: bypasses Row Level Security.
# Used to save orders from the order form and the Byl webhook.
SUPABASE_SECRET_KEY=

# Cal.com API key (server-only). Cal.com → Settings → Developer → API Keys → "+ Add".
# Lets the admin page list test drive bookings.
CAL_API_KEY=
